{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/Elvas_Interativa.pdf"
    }
  ],
  "headers": [
    {
      "source": "/Elvas_Interativa.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Elvas_Interativa.pdf\""
        }
      ]
    }
  ]
}
